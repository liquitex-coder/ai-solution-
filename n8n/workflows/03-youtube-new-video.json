      ]
    },
    "新動画あり？": {
      "main": [
        [{ "node": "Claude APIで動画紹介記事生成", "type": "main", "index": 0 }],
        [{ "node": "新動画なし（スキップ）", "type": "main", "index": 0 }]
      ]
    },
    "Claude APIで動画紹介記事生成": {
      "main": [
        [{ "node": "WordPress投稿データ整形", "type": "main", "index": 0 }]
      ]
