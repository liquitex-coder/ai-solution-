      "id": "7a8b9c0d-1e2f-3456-7890-012345678901",
      "name": "RSS結果を統合",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [700, 340]
    },
    {
      "parameters": {
        "jsCode": "// 重複チェックと新記事フィルタリング\n// n8nの静的データを使って既処理URLを記憶\nconst processedUrls = $getWorkflowStaticData('global').processedUrls || [];\nconst items = $input.all();\nconst newItems = [];\n\nfor (const item of items) {\n  const url = item.json.link || item.json.url || item.json.guid;\n  if (!url) continue;\n  \n  // 24時間以内の記事のみ対象（古い記事は除外）\n  const pubDate = item.json.pubDate || item.json.isoDate;\n  if (pubDate) {\n    const articleAge = Date.now() - new Date(pubDate).getTime();\n    const hoursOld = articleAge / (1000 * 60 * 60);\n    if (hoursOld > 24) continue;\n  }\n  \n  if (!processedUrls.includes(url)) {\n    newItems.push({\n      json: {\n        title: item.json.title || 'タイトルなし',\n        link: url,\n        pubDate: item.json.pubDate || item.json.isoDate || new Date().toISOString(),\n        summary: item.json.contentSnippet || item.json.content || item.json.summary || '本文なし',\n        source: item.json.creator || item.json.author || '不明'\n      }\n    });\n  }\n}\n\n// 処理済みURLを記録（最大500件保持）\nconst allUrls = [...processedUrls, ...newItems.map(i => i.json.link)];\n$getWorkflowStaticData('global').processedUrls = allUrls.slice(-500);\n\nconsole.log(`新記事数: ${newItems.length}件`);\nreturn newItems.length > 0 ? newItems : [{ json: { skip: true } }];"
      },
      "id": "8b9c0d1e-2f3a-4567-8901-123456789012",
      "name": "新記事フィルタリング（重複除外）",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 340]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "9c0d1e2f-3a4b-5678-9012-234567890123",
      "name": "新記事あり？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1140, 340]
