        "clashHandling": { "values": { "resolveClash": "preferInput1" } }
      },
      "id": "7a8b9c0d-1e2f-3456-7890-012345678901",
      "name": "RSS結果を統合",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [700, 340]
    },
    {
      "parameters": {
        "jsCode": "const processedUrls = $getWorkflowStaticData('global').processedUrls || [];\nconst items = $input.all();\nconst newItems = [];\n\nfor (const item of items) {\n  const url = item.json.link || item.json.url || item.json.guid;\n  if (!url) continue;\n  const pubDate = item.json.pubDate || item.json.isoDate;\n  if (pubDate) {\n    const hoursOld = (Date.now() - new Date(pubDate).getTime()) / (1000 * 60 * 60);\n    if (hoursOld > 24) continue;\n  }\n  if (!processedUrls.includes(url)) {\n    newItems.push({ json: { title: item.json.title || 'タイトルなし', link: url, pubDate: item.json.pubDate || new Date().toISOString(), summary: item.json.contentSnippet || '', source: item.json.creator || '不明' } });\n  }\n}\n\nconst allUrls = [...processedUrls, ...newItems.map(i => i.json.link)];\n$getWorkflowStaticData('global').processedUrls = allUrls.slice(-500);\nreturn newItems.length > 0 ? newItems : [{ json: { skip: true } }];"
      },
      "id": "8b9c0d1e-2f3a-4567-8901-123456789012",
      "name": "新記事フィルタリング（重複除外）",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 340]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.skip }}", "rightValue": true, "operator": { "type": "boolean", "operation": "notEquals" } }],
          "combinator": "and"
        }
      },
      "id": "9c0d1e2f-3a4b-5678-9012-234567890123",
      "name": "新記事あり？",
      "type": "n8n-nodes-base.if",
