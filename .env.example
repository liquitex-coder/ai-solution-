# MySQL
MYSQL_ROOT_PASSWORD=wordpress_root
MYSQL_PASSWORD=wordpress

# n8n
N8N_USER=admin
N8N_PASSWORD=changeme

# Claude API
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Kimi API (Moonshot AI) — ZH source processing (WF08)
KIMI_API_KEY=sk-YOUR_KIMI_KEY_HERE

# GitHub
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# YouTube Data API v3
YOUTUBE_API_KEY=YOUR_YOUTUBE_KEY_HERE

# Perplexity API
PERPLEXITY_API_KEY=pplx-YOUR_KEY_HERE

# fal.ai (Flux.1 featured image generation)
FAL_API_KEY=YOUR_FAL_KEY_HERE

# Google Drive API (WF07 NoimosAI integration)
GOOGLE_DRIVE_CREDENTIALS=YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# WordPress — self-hosted sandbox (Basic auth via docker-compose)
WP_URL=http://localhost:8080
WP_USERNAME=admin
WP_APP_PASSWORD=YOUR_APP_PASSWORD_HERE

# WordPress.com — production (requirements §24). Two-step auth active sites
# reject Basic/Application-Password directly; use an OAuth2 password-grant
# Bearer token instead. WP_SITE is the unmapped wordpress.com domain, not a
# mapped custom domain (e.g. liquitex929aa21393-eyqci.wordpress.com, not
# aiguide.blog). Setting WP_BEARER_TOKEN takes precedence over WP_APP_PASSWORD
# in scripts/wp-init.sh.
WP_SITE=liquitex929aa21393-eyqci.wordpress.com
WP_BEARER_TOKEN=YOUR_OAUTH2_ACCESS_TOKEN_HERE

# Claim-Auditor gate rollout mode (requirements §22-3): report_only | canary | full
CLAIM_AUDITOR_MODE=report_only
