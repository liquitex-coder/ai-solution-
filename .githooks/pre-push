#!/usr/bin/env bash
# Mandatory pre-push gate — runs the CLAUDE.md §D local gates (absolute rule 3).
# Emergency bypass: SKIP_GATES=1 git push ...  (use only when gates cannot run;
# the push is then unverified and must not be reported as gate-green.)
set -euo pipefail
if [ "${SKIP_GATES:-0}" = "1" ]; then
  echo "[pre-push] SKIP_GATES=1 — gates BYPASSED (unverified push)" >&2
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
PY=python3; "$PY" -c "pass" >/dev/null 2>&1 || PY="py -3"
echo "[pre-push] running local gates (CLAUDE.md §D)..."
$PY scripts/check_wired.py
$PY scripts/run_eval.py
$PY -m unittest discover -s tests
$PY scripts/ratchet_check.py
echo "[pre-push] all gates green — push allowed"
