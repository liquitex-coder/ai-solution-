#!/usr/bin/env bash
# CLAUDE.md §C-1 sensor: reject a commit body naming a file outside the diff.
# Emergency bypass: SKIP_COMMIT_MSG_CHECK=1 git commit ...
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PY=python3; "$PY" -c "pass" >/dev/null 2>&1 || PY="py -3"
$PY scripts/check_commit_message.py "$1"
